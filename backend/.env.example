# ---- Blockchain ----
WEB3_PROVIDER_URI=http://127.0.0.1:8545
CONTRACT_ADDRESS=0xYourDeployedContractAddress
ISSUER_PRIVATE_KEY=0xYourIssuerAccountPrivateKey
CHAIN_ID=31337

# ---- IPFS ----
# storage backend: "local" (local IPFS daemon) or "web3storage"
STORAGE_BACKEND=local
IPFS_API_ADDR=/ip4/127.0.0.1/tcp/5001
WEB3STORAGE_API_TOKEN=

# ---- Digital signature (RSA keypair for the issuing institution) ----
RSA_PRIVATE_KEY_PATH=keys/issuer_private_key.pem
RSA_PUBLIC_KEY_PATH=keys/issuer_public_key.pem

# ---- Forgery detection ----
ELA_QUALITY=90
FORGERY_SCORE_THRESHOLD=0.35
